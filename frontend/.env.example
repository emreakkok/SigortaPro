# SigortaPro frontend ortam değişkenleri.
# Bu dosyayı `.env` olarak kopyalayıp değerleri ortamınıza göre düzenleyin.
# Yalnızca VITE_ önekli değişkenler istemci koduna açılır — buraya asla gizli değer koymayın.

# Backend API kök adresi (versiyon dahil). Backend varsayılan dev portu: 5153.
VITE_API_BASE_URL=http://localhost:5153/api/v1
